# Copy to .env and fill in real values. Never commit real credentials.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/ruoyi_next"
# REQUIRED in production: >= 32 chars of strong randomness.
# Generate with: openssl rand -base64 48
# Since v0.1.1 a missing/weak value fails fast instead of using a known key.
JWT_SECRET="replace-with-at-least-32-random-characters"

# Optional: enable the machine-to-machine service token channel.
# Leave empty to disable it entirely.
SERVICE_TOKEN=""

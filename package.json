    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "postcss": "^8.5.32",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.8.0"

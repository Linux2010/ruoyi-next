    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@refinedev/core": "^5.0.0",
    "@refinedev/nextjs-router": "^7.0.0",
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-table": "^8.11.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "jose": "^6.2.3",
